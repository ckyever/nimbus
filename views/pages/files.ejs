<div class="content">
  <div class="page-title">
    <h2>My Files</h2>
    <div class="actions">
      <% if (locals.parentFolderId) {
      %>
      <a class="file-action" href="/files/<%=locals.parentFolderId%>">
        <svg class="icon" alt="Previous folder icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20 18H4V8H20M20 6H12L10 4H4A2 2 0 0 0 2 6V18A2 2 0 0 0 4 20H20A2 2 0 0 0 22 18V8A2 2 0 0 0 20 6M16 17H14V13H11L15 9L19 13H16Z" fill="var(--icon-fill-colour)"/></svg>
        Previous Folder
      </a>
      <% } %>
      <%- include("../partials/upload-file-button", {files: files}) %>
      <%- include("../partials/new-folder-button", {files: files}) %>
    </div>
  </div>
  <div class="file-window">
    <%- include("../partials/file-tree", {files: files}) %>
  </div>
</div>