<div class="content">
  <h1>Files</h1>
  <button id="new-folder-button">New Folder</button>
  <dialog id="new-folder-dialog">
    <form action="/new-folder<%= locals.path %>" method="POST">
      <input
        type="folder-name"
        name="folder-name"
        id="folder-name"
        aria-label="folder-name"
        required
      />
      <button type="submit">Create</button>
      <button id="new-folder-cancel" type="reset">Cancel</button>
    </form>
  </dialog>
  <%- include("../partials/errors.ejs") %>
</div>

<script>
  const newFolderButton = document.getElementById("new-folder-button");
  const newFolderDialog = document.getElementById("new-folder-dialog");
  const newFolderDialogCancel = document.getElementById("new-folder-cancel");

  newFolderButton.addEventListener("click", () => {
    newFolderDialog.showModal();
  });

  newFolderDialogCancel.addEventListener("click", () => {
    newFolderDialog.close();
  });
</script>
