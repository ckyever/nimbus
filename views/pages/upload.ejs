<div class="content">
  <h1>Upload a new file</h1>
  <form
    class="upload"
    action="/upload"
    method="POST"
    enctype="multipart/form-data"
  >
    <input type="file" name="file" id="file" aria-label="file" required />
    <button type="submit">Upload</button>
  </form>
  <%- include("../partials/errors.ejs") %>
</div>
