<%
  const options = {
    hour: '2-digit',
    minute: '2-digit',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour12: false,
  }
  const dateFormatter = new Intl.DateTimeFormat("en-AU", options);
%>

<% if (locals.files) {%>
<table>
  <tr>
    <th>Name</th>
    <th>Type</th>
    <th>Modified</th>
    <th>Created</th>
  </tr>
  <% files.forEach((file) => { %>
    <%const modifiedOn = dateFormatter.format(file.modified_on);%>
    <%const createdOn = dateFormatter.format(file.created_on);%>
    <tr>
      <td><a href="/files/<%= file.id %>"><%= file.name %></a></td>
      <td><%= file.type %></td>
      <td><%= modifiedOn %></td>
      <td><%= createdOn %></td>
    </tr>
  <% }); %>
</table>
<% } %>