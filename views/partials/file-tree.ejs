<%
  const options = {
    hour: '2-digit',
    minute: '2-digit',
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour12: false,
  }
  const dateFormatter = new Intl.DateTimeFormat("en-AU", options);
%>

<div class="file-tree">
  <div class="cell heading">Name</div>
  <div class="cell heading">Type</div>
  <div class="cell heading">Size (kB)</div>
  <div class="cell heading">Modified</div>
  <div class="cell heading">Created</div>
  <div class="cell heading"></div>
  <% files.forEach((file) => { %>
    <%const modifiedOn = dateFormatter.format(file.modified_on);%>
    <%const createdOn = dateFormatter.format(file.created_on);%>
    <% if (file.type === "FOLDER") { %>
      <div class="cell">
        <a class="file-folder-name" href="/files/<%= file.id %>">
          <svg class="icon" alt="Folder icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" fill="var(--icon-fill-colour)" /></svg>
          <%= file.name %>
        </a>
      </div>
    <% } else { %>
      <div class="cell">
        <a class="file-folder-name" href="<%= file.url %>" download target="_blank"">
          <svg class="icon" alt="File icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" fill="var(--icon-fill-colour)"/></svg>
          <%= file.name %>
        </a>
      </div>
    <% } %>
    <div class="cell"><%= file.type %></div>
    <div class="cell"><%= file.size ? (Number(file.size)/1000).toFixed(2) : null %></div>
    <div class="cell"><%= modifiedOn %></div>
    <div class="cell"><%= createdOn %></div>
    <div class="cell">
      <a class="delete-link" href="/files/<%= file.id %>/delete">
        <svg class="icon" alt="Delete icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M14.59,8L12,10.59L9.41,8L8,9.41L10.59,12L8,14.59L9.41,16L12,13.41L14.59,16L16,14.59L13.41,12L16,9.41L14.59,8Z" fill="var(--icon-fill-colour)"/></svg>
      </a>
    </div>
  <% }); %>
</div>

<dialog id="delete-dialog">
  <div class="dialog-container">
    <div>Are you sure you want to delete?</div>
    <div class="dialog-buttons">
      <button id="yes-delete">Yes</button>
      <button id="no-delete">No</button>
    <div class="dialog-buttons">
  </div>
</dialog>

<script>
  const fileTreeTable = document.querySelector(".file-tree");
  const deleteDialog = document.getElementById("delete-dialog");
  const deleteYes = document.getElementById("yes-delete");
  const deleteNo = document.getElementById("no-delete");
  let targetUrl = "";

  fileTreeTable.addEventListener("click", (event) => {
    console.log("classList=" + event.target.classList);
    if (event.target.classList.contains("delete-link")) {
      event.preventDefault();
      targetUrl = event.target.href;
      deleteDialog.showModal();
    }
  });

  deleteYes.addEventListener("click", async (event) => {
    await fetch(targetUrl);
    document.location.reload();
    deleteDialog.close();
  });

  deleteNo.addEventListener("click", (event) => {
    deleteDialog.close();
  });
</script>