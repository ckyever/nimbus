<button id="new-folder-button">New Folder</button>
<dialog id="new-folder-dialog">
  <form id="new-folder-form" action="/new-folder" method="POST">
    <input
      type="folder-name"
      name="folder-name"
      id="new-folder-name"
      aria-label="folder-name"
      required
    />
    <input
      type="hidden"
      name="parent-folder-id"
      value="<%= locals.currentFolderId %>"
    />
    <button type="submit">Create</button>
    <button id="new-folder-cancel" type="reset">Cancel</button>
  </form>
  <div id="new-folder-message"></div>
</dialog>

<script>
  const newFolderButton = document.getElementById("new-folder-button");
  const newFolderDialog = document.getElementById("new-folder-dialog");
  const newFolderDialogCancel = document.getElementById("new-folder-cancel");
  const newFolderForm = document.getElementById("new-folder-form");
  const newFolderMessage = document.getElementById("new-folder-message");
  const folderNameInput = document.getElementById("new-folder-name");

  const fileNamesInCurrentFolder = <%- JSON.stringify(files.map((file) => file.name)) %>;

  folderNameInput.addEventListener("input", (event) => {
    if (fileNamesInCurrentFolder.some((file) => file === event.target.value)) {
      folderNameInput.setCustomValidity(
        "This file/folder already exists"
      );
    } else {
      folderNameInput.setCustomValidity("");
    }
  });

  const newFolderError = "Unable to create this folder";

  newFolderButton.addEventListener("click", () => {
    newFolderDialog.showModal();
  });

  newFolderForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.target;
    const formData = new FormData(form);

    let response;
    try {
      response = await fetch(form.action, {
        method: form.method,
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
        },
        body: new URLSearchParams(formData).toString(),
      });
    } catch {
      console.error("Failed to request folder creation");
      newFolderMessage.innerText = newFolderError;
      return;
    }

    const data = await response.json();
    if (data.success) {
      window.location.reload();
    } else {
      newFolderMessage.innerText = newFolderError;
    }
  });

  newFolderDialogCancel.addEventListener("click", () => {
    newFolderDialog.close();
  });
</script>
