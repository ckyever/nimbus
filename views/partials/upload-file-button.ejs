<button id="upload-file-button" class="file-action">
  <svg
    class="icon"
    alt="Upload file icon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
  >
    <path
      d="M9,10V16H15V10H19L12,3L5,10H9M12,5.8L14.2,8H13V14H11V8H9.8L12,5.8M19,18H5V20H19V18Z"
      fill="var(--icon-fill-colour)"
    />
  </svg>
  Upload File
</button>
<dialog id="upload-file-dialog">
  <div class="dialog-container">
    <form
      id="upload-file-form"
      action="/upload"
      method="POST"
      enctype="multipart/form-data"
    >
      <input
        type="file"
        name="file"
        id="upload-file"
        aria-label="file"
        required
      />
      <input
        type="hidden"
        name="parent-folder-id"
        value="<%= locals.currentFolderId %>"
      />
      <div class="dialog-buttons">
        <button type="submit">Upload</button>
        <button id="upload-file-cancel" type="reset">Cancel</button>
      </div>
    </form>
    <div id="upload-file-message"></div>
  </div>
</dialog>

<script>
  const uploadFileButton = document.getElementById("upload-file-button");
  const uploadFileDialog = document.getElementById("upload-file-dialog");
  const uploadFileDialogCancel = document.getElementById("upload-file-cancel");
  const uploadFileForm = document.getElementById("upload-file-form");
  const uploadFileMessage = document.getElementById("upload-file-message");

  const uploadFileError = "Unable to upload this file";

  uploadFileButton.addEventListener("click", () => {
    uploadFileDialog.showModal();
  });

  uploadFileForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = event.target;
    const formData = new FormData(form);

    let response;
    try {
      response = await fetch(form.action, {
        method: form.method,
        body: formData,
      });
    } catch {
      console.error("Failed to request file upload");
      uploadFileMessage.innerText = uploadFileError;
      return;
    }

    const data = await response.json();
    if (data.success) {
      window.location.reload();
    } else {
      uploadFileMessage.innerText = uploadFileError;
    }
  });

  uploadFileDialogCancel.addEventListener("click", () => {
    uploadFileDialog.close();
  });
</script>
